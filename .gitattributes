# Word-asiakirjat ovat binaareja: ei rivinvaihtomuunnoksia, ei tekstidiffia.
*.docx binary
*.pdf binary
# Tekstitiedostot LF-muodossa alustasta riippumatta
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
# Koukut ajetaan sh:lla myös Windowsin Git Bashissa — CRLF rikkoisi ne
.githooks/* text eol=lf
