{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-workspace-fi/kokoonpano.schema.json",
  "title": "Hallituksen kokoonpanorekisteri (company/hallituksen-kokoonpano.yaml)",
  "type": "object",
  "required": ["schema_version", "record_type", "terms"],
  "properties": {
    "schema_version": { "const": 2 },
    "record_type": { "const": "board_composition_register" },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term_id", "valid_from", "members"],
        "properties": {
          "term_id": { "type": "string", "minLength": 1 },
          "valid_from": { "type": "string", "format": "date" },
          "valid_until": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
          "selection_basis": { "type": ["string", "null"] },
          "source_document": { "type": ["string", "null"] },
          "status": { "enum": ["provisional", "confirmed"] },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["person_id", "display_name", "board_role"],
              "properties": {
                "person_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "display_name": { "type": "string", "minLength": 1 },
                "board_role": { "enum": ["chair", "vice_chair", "member", "deputy"] },
                "valid_from": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
                "valid_until": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
                "decision_right": { "type": ["boolean", "null"] },
                "executive_role": { "enum": ["ceo", null] },
                "elected_by": { "type": ["string", "null"] },
                "role_elected_by": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "ceo": {
      "type": ["object", "null"],
      "properties": {
        "person_id": { "anyOf": [ { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, { "type": "null" } ] },
        "display_name": { "type": ["string", "null"] },
        "valid_from": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
        "valid_until": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
        "appointed_by": { "type": ["string", "null"] }
      }
    },
    "quorum_rule": {
      "type": ["object", "null"],
      "properties": {
        "type": { "enum": ["more_than_half", "fraction", "min_count"] },
        "numerator": { "type": ["integer", "null"] },
        "denominator": { "type": ["integer", "null"] },
        "min_count": { "type": ["integer", "null"] },
        "source": { "type": ["string", "null"] },
        "tie_break": { "enum": ["chair_casting_vote", "articles_of_association", null] }
      }
    },
    "signature_policy": {
      "type": ["object", "null"],
      "properties": {
        "required_signers": { "enum": ["chair_plus_one", "all_members_in_term", "all_present_members"] },
        "includes_absent_members": { "type": ["boolean", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "review_policy": {
      "type": ["object", "null"],
      "properties": {
        "required_reviewers": { "enum": ["all_members_in_term", "all_present_members", "chair_only", null] },
        "content_change_starts_new_round": { "type": ["boolean", "null"] }
      }
    },
    "secretary": {
      "type": ["object", "null"],
      "properties": {
        "responsible_person_id": { "type": ["string", "null"] },
        "ai_may_prepare_draft": { "type": ["boolean", "null"] },
        "ai_is_formal_secretary": { "const": false }
      }
    },
    "known_gaps": { "type": ["array", "null"], "items": { "type": "string" } }
  }
}
