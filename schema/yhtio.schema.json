{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-workspace-fi/yhtio.schema.json",
  "title": "Yhtiön perustiedot (company/yhtio.yaml)",
  "type": "object",
  "required": ["schema_version", "record_type", "id_prefix"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "company" },
    "name": { "type": ["string", "null"] },
    "business_id": { "anyOf": [ { "type": "string", "pattern": "^[0-9]{7}-[0-9]$" }, { "type": "null" } ] },
    "company_form": { "enum": ["oy", "oyj", "muu", null] },
    "domicile": { "type": ["string", "null"] },
    "industry": { "type": ["string", "null"] },
    "fiscal_year": {
      "type": ["object", "null"],
      "properties": {
        "starts": { "anyOf": [ { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" }, { "type": "null" } ] },
        "ends": { "anyOf": [ { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" }, { "type": "null" } ] }
      }
    },
    "has_ceo": { "type": ["boolean", "null"] },
    "has_auditor": { "type": ["boolean", "null"] },
    "minutes_archive": { "type": ["string", "null"] },
    "id_prefix": {
      "type": "object",
      "required": ["minutes", "decision"],
      "properties": {
        "minutes": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-$" },
        "decision": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-$" }
      }
    },
    "access_and_continuity": { "type": ["object", "null"] },
    "onboarding": { "type": ["object", "null"] }
  }
}
